# ==============================================================================
# PROJECT ANTIGRAVITY (TIA Phase 1 - Ghana JHS MVP)
# Environment Variables Configuration Template
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL
# ==============================================================================

# Database Configuration (PostgreSQL with pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=antigravity_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Primary Prisma / SQLAlchemy Connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/antigravity_db?schema=public

# Core API (Node.js / Express)
CORE_API_PORT=4000
CORE_API_HOST=localhost
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=replace_with_a_secure_random_64_character_hex_refresh_string
REFRESH_TOKEN_EXPIRES_IN=30d

# Cryptographic Keys (AES-256-GCM for JHS Learner PII Encryption)
# Must be exactly 32 bytes (64 hex characters)
PII_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Eligibility & AI Services (Python / FastAPI)
FASTAPI_PORT=8000
FASTAPI_HOST=0.0.0.0
INTERNAL_SERVICE_SECRET=replace_with_internal_service_mesh_secret_token

# AI / RAG Pipeline (OpenAI Embedding & LLM)
OPENAI_API_KEY=sk-placeholder-replace-with-valid-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536
OPENAI_COMPLETION_MODEL=gpt-4o-mini

# Frontend (Next.js App Router)
PORT=3000
NEXT_PUBLIC_CORE_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000/api/v1

# Environment
NODE_ENV=development
